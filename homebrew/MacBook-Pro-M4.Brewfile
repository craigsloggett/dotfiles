tap "hashicorp/tap", trusted: true

brew "git"
brew "gnupg"
brew "hashicorp/tap/terraform", trusted: true
brew "jq"
brew "neovim"
brew "openssh"
brew "pass"
brew "ripgrep"
brew "shellcheck"
brew "shfmt"
brew "syncthing", start_service: true
brew "terraform-ls"
brew "tree-sitter-cli"
brew "ykman"
brew "zsh-autosuggestions"

cask "claude-code@latest"
cask "firefox"
cask "ghostty"
cask "keepassxc"
cask "obsidian"
cask "rectangle"
cask "signal"
cask "slack"
cask "utm"
