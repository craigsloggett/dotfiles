#!/bin/sh

set -eu

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-${HOME}/.local/state}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
export XDG_BIN_HOME="${XDG_BIN_HOME:-${HOME}/.local/bin}"
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/opt/homebrew/opt/rustup/bin:/Applications/Ghostty.app/Contents/MacOS:${PATH}:${XDG_BIN_HOME}"

repo='craigsloggett/dotfiles'
readonly repo

if [ "${0##*/}" = install ]; then
  dotfiles="$(cd "$(dirname -- "${0}")" && pwd)"
else
  dotfiles="${HOME}/Developer/GitHub/${repo}"
fi
readonly dotfiles

conflict() {
  printf '%s\n' "$*" >>"${conflicts}"
  printf '%s\n' "$*" >&2
}

need_sudo() {
  sudo -n -v 2>/dev/null || printf '%s\n' "$*"
}

symlink() (
  source="${1:?a symlink source is required}"
  target="${2:?a symlink target is required}"

  [ -e "${source}" ] || return 0
  [ "$(readlink "${target}")" != "${source}" ] || return 0

  if [ -e "${target}" ] && [ ! -L "${target}" ]; then
    conflict "Not linking ${target}, it already exists."
    return 0
  fi

  mkdir -p "${target%/*}"
  ln -sfn "${source}" "${target}"
  printf '%s\n' "Linked ${target} to ${source}."
)

make_dirs() {
  for dir in "$@"; do
    if [ ! -d "${dir}" ]; then
      mkdir -p "${dir}"
      printf '%s\n' "Created ${dir}."
    fi
  done
}

migrate() (
  source="${1:?a migration source is required}"
  target="${2:?a migration target is required}"

  [ -e "${source}" ] || return 0

  if [ -e "${target}" ]; then
    conflict "Not moving ${source}, ${target} already exists."
    return 0
  fi

  mkdir -p "${target%/*}"
  mv "${source}" "${target}"
  printf '%s\n' "Moved ${source} to ${target}."
)

merge_history() (
  source="${1:?a history source is required}"
  target="${2:?a history target is required}"

  [ -e "${source}" ] || return 0

  if [ -e "${target}" ]; then
    cat "${target}" >>"${source}"
  fi

  mkdir -p "${target%/*}"
  mv "${source}" "${target}"
  printf '%s\n' "Merged ${source} into ${target}."
)

remove() {
  for file in "$@"; do
    if [ -e "${file}" ]; then
      rm -rf "${file}"
      printf '%s\n' "Removed ${file}."
    fi
  done
}

remove_empty() {
  for dir in "$@"; do
    [ -d "${dir}" ] || continue
    [ -z "$(ls -A "${dir}")" ] || continue
    rmdir "${dir}"
    printf '%s\n' "Removed ${dir}."
  done
}

ask() (
  prompt="${1:?a prompt is required}"

  printf '%s: ' "${prompt}" >&2
  read -r answer || return 1
  printf '%s\n' "${answer}"
)

load_environment() {
  for file in "${dotfiles}"/zsh/.zprofile.d/*.sh; do
    # shellcheck source=/dev/null
    . "${file}"
  done
}

zshenv() {
  cat <<'EOF'
export ZDOTDIR="${XDG_CONFIG_HOME:-${HOME}/.config}/zsh"
EOF
}

require_full_disk_access() {
  for dir in Safari Cookies Suggestions Messages; do
    if ls "${HOME}/Library/${dir}" >/dev/null 2>&1; then
      return 0
    fi
  done

  open 'x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles'
  printf '%s\n' "Turn on Full Disk Access for this terminal in the System Settings pane that just opened, quit and reopen the terminal, then run the same command again." >&2
  return 1
}

profile_linked() (
  brewfile="${XDG_CONFIG_HOME}/homebrew/Brewfile"
  [ -L "${brewfile}" ] && [ -e "${brewfile}" ]
)

list_profiles() (
  url="https://api.github.com/repos/${repo}/contents/homebrew"

  if [ -d "${dotfiles}/.git" ]; then
    for file in "${dotfiles}"/homebrew/*.Brewfile; do
      [ -e "${file}" ] || continue
      name="${file##*/}"
      printf '%s\n' "${name%.Brewfile}"
    done
    return 0
  fi

  if ! contents="$(curl -fsSL "${url}")"; then
    printf '%s\n' "GitHub is unreachable, install needs network access." >&2
    return 1
  fi

  printf '%s\n' "${contents}" | jq -r '.[].name | select(endswith(".Brewfile")) | rtrimstr(".Brewfile")'
)

ask_questions() {
  profile=''
  host_name=''
  email=''

  if ! profile_linked; then
    computer_name="$(scutil --get ComputerName)"
    profiles="$(list_profiles)"

    choices=''
    default_profile=''
    for name in ${profiles}; do
      choices="${choices:+${choices}, }${name}"
      [ "${name}" != "${computer_name}" ] || default_profile="${name}"
    done

    while :; do
      profile="$(ask "Profile for this Mac (${choices})${default_profile:+ [${default_profile}]}")"
      profile="${profile:-${default_profile}}"
      case ", ${choices}, " in
        *", ${profile}, "*) break ;;
        *) printf '%s\n' "Pick one of: ${choices}." >&2 ;;
      esac
    done

    while :; do
      host_name="$(ask "Hostname for this Mac [${computer_name}]")"
      case "${host_name}" in
        -* | *- | *[!A-Za-z0-9-]*) printf '%s\n' "Use only letters, digits and inner hyphens." >&2 ;;
        *) break ;;
      esac
    done
    [ "${host_name}" != "${computer_name}" ] || host_name=''
  fi

  if [ ! -e "${XDG_CONFIG_HOME}/git/config-personal" ] && [ ! -e "${HOME}/.gitconfig" ]; then
    email="$(ask 'Email address for Git commits')"
  fi
}

ssh_handle() (
  for handle in "${HOME}"/.ssh/id_ed25519_sk_rk*; do
    [ -e "${handle}" ] || continue
    case "${handle}" in *.pub) continue ;; esac
    printf '%s\n' "${handle}"
    return 0
  done
  return 1
)

ssh_agent_key() (
  [ -n "${SSH_AUTH_SOCK:-}" ] || return 1
  ssh-add -L 2>/dev/null | awk '$1 ~ /^sk-/ { print "key::" $1, $2; exit }' | grep .
)

pull_ssh_keys() (
  ! ssh_handle >/dev/null || return 0
  ! ssh_agent_key >/dev/null || return 0

  if [ ! -x /opt/homebrew/bin/ssh-keygen ]; then
    conflict "Apple's ssh-keygen cannot read FIDO keys, add openssh to the Brewfile, then run install again."
    return 0
  fi

  make_dirs "${HOME}/.ssh"
  chmod 700 "${HOME}/.ssh"

  printf '%s\n' "Enter the FIDO PIN and touch the YubiKey to pull its SSH key."
  if ! (cd "${HOME}/.ssh" && /opt/homebrew/bin/ssh-keygen -K); then
    conflict "No SSH key found, plug in a YubiKey or connect with a forwarded agent, then run install again."
  fi
)

set_hostname() (
  name="${1:?a hostname is required}"
  smb='/Library/Preferences/SystemConfiguration/com.apple.smb.server'

  for key in ComputerName LocalHostName HostName; do
    [ "$(scutil --get "${key}" 2>/dev/null)" != "${name}" ] || continue
    need_sudo "Setting the hostname needs sudo access."
    sudo scutil --set "${key}" "${name}"
    printf '%s\n' "Set ${key} to ${name}."
  done

  [ "${#name}" -le 15 ] || return 0
  [ "$(defaults read "${smb}" NetBIOSName 2>/dev/null)" != "${name}" ] || return 0
  need_sudo "Setting the hostname needs sudo access."
  sudo defaults write "${smb}" NetBIOSName -string "${name}"
  printf '%s\n' "Set NetBIOSName to ${name}."
)

configure_host() (
  ! profile_linked || return 0

  if [ ! -f "${dotfiles}/homebrew/${profile}.Brewfile" ]; then
    conflict "No profile named '${profile}' in ${dotfiles}/homebrew."
    return 0
  fi

  [ -z "${host_name}" ] || set_hostname "${host_name}"

  symlink "${dotfiles}/homebrew/${profile}.Brewfile" "${XDG_CONFIG_HOME}/homebrew/Brewfile"
)

install_homebrew() (
  [ ! -x /opt/homebrew/bin/brew ] || return 0

  installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  printf '%s\n' "Installing Homebrew, which needs sudo access."
  sudo -v
  NONINTERACTIVE=1 /bin/bash -c "${installer}"
)

clone_dotfiles() {
  [ ! -d "${dotfiles}/.git" ] || return 0

  install_homebrew
  git clone "https://github.com/${repo}.git" "${dotfiles}"
}

require_app_store() (
  brewfile="${XDG_CONFIG_HOME}/homebrew/Brewfile"

  grep -q '^mas ' "${brewfile}" || return 0
  HOMEBREW_NO_AUTO_UPDATE=1 /opt/homebrew/bin/brew bundle check --global --no-upgrade --verbose 2>&1 |
    grep -q '^→ App ' || return 0

  need_sudo "Installing App Store apps needs sudo access."
  open -a 'App Store'
  ask 'Sign in to the App Store in the window that just opened, then press Enter' >/dev/null
)

configure_homebrew() {
  install_homebrew
  symlink "${dotfiles}/homebrew/brew.env" "${XDG_CONFIG_HOME}/homebrew/brew.env"

  [ -e "${XDG_CONFIG_HOME}/homebrew/Brewfile" ] || return 0

  if ! HOMEBREW_NO_AUTO_UPDATE=1 /opt/homebrew/bin/brew bundle check --global --no-upgrade >/dev/null 2>&1; then
    require_app_store
    /opt/homebrew/bin/brew bundle install --global --no-upgrade ||
      conflict "Homebrew could not install everything, sign in to the App Store if an App failed."
  fi

  HOMEBREW_NO_AUTO_UPDATE=1 /opt/homebrew/bin/brew bundle cleanup --global --force
}

configure_zsh() {
  if [ "$(cat /etc/zshenv 2>/dev/null)" != "$(zshenv)" ]; then
    need_sudo "Writing /etc/zshenv needs sudo access."
    zshenv | sudo tee /etc/zshenv >/dev/null
    printf '%s\n' "Wrote /etc/zshenv."
  fi

  symlink "${dotfiles}/zsh" "${XDG_CONFIG_HOME}/zsh"
  make_dirs "${XDG_STATE_HOME}/zsh" "${XDG_CACHE_HOME}/zsh"
  merge_history "${HOME}/.zsh_history" "${XDG_STATE_HOME}/zsh/history"
  remove "${HOME}/.zcompdump" "${HOME}/.zsh_sessions" "${HOME}/.zprofile" "${HOME}/.zshrc"
}

configure_editorconfig() {
  symlink "${dotfiles}/editorconfig/.editorconfig" "${HOME}/.editorconfig"
}

configure_vim() {
  symlink "${dotfiles}/vim" "${XDG_CONFIG_HOME}/vim"
  migrate "${HOME}/.viminfo" "${XDG_STATE_HOME}/vim/viminfo"
  make_dirs \
    "${XDG_STATE_HOME}/vim" \
    "${XDG_DATA_HOME}/vim/spell" \
    "${XDG_DATA_HOME}/vim/view" \
    "${XDG_CACHE_HOME}/vim/backup" \
    "${XDG_CACHE_HOME}/vim/swap" \
    "${XDG_CACHE_HOME}/vim/undo"
}

configure_nvim() {
  symlink "${dotfiles}/nvim" "${XDG_CONFIG_HOME}/nvim"
}

signing_key() {
  ssh_handle || ssh_agent_key
}

configure_git() (
  personal="${XDG_CONFIG_HOME}/git/config-personal"

  symlink "${dotfiles}/git" "${XDG_CONFIG_HOME}/git"
  migrate "${HOME}/.gitconfig" "${personal}"

  if [ -z "$(git config --file "${personal}" user.email)" ]; then
    if [ -n "${email}" ]; then
      git config --file "${personal}" user.email "${email}"
      printf '%s\n' "Set user.email in ${personal}."
    else
      conflict "No Git email set, add user.email to ${personal}."
    fi
  fi

  if [ -z "$(git config --file "${personal}" user.signingKey)" ]; then
    if key="$(signing_key)"; then
      git config --file "${personal}" user.signingKey "${key}"
      printf '%s\n' "Set user.signingKey in ${personal}."
    else
      conflict "No SSH signing key found, add user.signingKey to ${personal}."
    fi
  fi
)

configure_gpg() (
  migrate "${HOME}/.gnupg" "${XDG_DATA_HOME}/gnupg"
  make_dirs "${XDG_DATA_HOME}/gnupg"
  chmod 700 "${XDG_DATA_HOME}/gnupg"

  for conf in gpg.conf gpg-agent.conf; do
    symlink "${dotfiles}/gnupg/${conf}" "${XDG_DATA_HOME}/gnupg/${conf}"
  done
)

configure_go() {
  migrate "${HOME}/go" "${GOPATH}"
  make_dirs "${GOBIN}"

  for binary in "${GOPATH}"/bin/*; do
    [ -e "${binary}" ] || continue
    migrate "${binary}" "${GOBIN}/${binary##*/}"
  done

  remove_empty "${GOPATH}/bin"
}

configure_pass() {
  migrate "${HOME}/.password-store" "${PASSWORD_STORE_DIR}"
}

configure_less() {
  migrate "${HOME}/.lesshst" "${LESSHISTFILE}"
  make_dirs "${LESSHISTFILE%/*}"
}

configure_python3() {
  migrate "${HOME}/.python_history" "${PYTHON_HISTORY}"
  migrate "${HOME}/.matplotlib" "${MPLCONFIGDIR}"
  make_dirs "${PYTHON_HISTORY%/*}"
}

configure_bundle() {
  migrate "${HOME}/.bundle/cache" "${BUNDLE_USER_CACHE}"
  migrate "${HOME}/.bundle/config" "${BUNDLE_USER_CONFIG}"
  migrate "${HOME}/.bundle/plugin" "${BUNDLE_USER_PLUGIN}"
  remove_empty "${HOME}/.bundle"
}

configure_terraform() {
  symlink "${dotfiles}/terraform" "${XDG_CONFIG_HOME}/terraform"
  make_dirs "${XDG_CACHE_HOME}/terraform"
  remove "${HOME}/.terraform.d/checkpoint_cache" "${HOME}/.terraform.d/checkpoint_signature"
  remove_empty "${HOME}/.terraform.d"
}

configure_tflint() (
  symlink "${dotfiles}/tflint" "${XDG_CONFIG_HOME}/tflint"
  migrate "${HOME}/.tflint.d" "${XDG_DATA_HOME}/tflint"
  make_dirs "${XDG_DATA_HOME}/tflint"

  directory="$(mktemp -d)"
  tflint --chdir "${directory}" >/dev/null 2>&1 || tflint --chdir "${directory}" --init
  rmdir "${directory}"
  remove "${HOME}/.sigstore"
)

configure_yamllint() {
  symlink "${dotfiles}/yamllint" "${XDG_CONFIG_HOME}/yamllint"
}

configure_yamlfmt() {
  symlink "${dotfiles}/yamlfmt" "${XDG_CONFIG_HOME}/yamlfmt"
}

configure_gh() {
  symlink "${dotfiles}/gh/config.yml" "${XDG_CONFIG_HOME}/gh/config.yml"
}

configure_ghostty() {
  symlink "${dotfiles}/ghostty" "${XDG_CONFIG_HOME}/ghostty"
  migrate "${HOME}/.terminfo" "${TERMINFO}"

  for entry in /Applications/Ghostty.app/Contents/Resources/terminfo/*; do
    symlink "${entry}" "${TERMINFO}/${entry##*/}"
  done
}

configure_claude() (
  migrate "${HOME}/.claude" "${CLAUDE_CONFIG_DIR}"
  migrate "${HOME}/.claude.json" "${CLAUDE_CONFIG_DIR}/.claude.json"

  for entry in "${CLAUDE_CONFIG_DIR}"/plugins/*; do
    [ -e "${entry}" ] || continue
    [ "${entry##*/}" != synced ] || continue
    migrate "${entry}" "${CLAUDE_CODE_PLUGIN_CACHE_DIR}/${entry##*/}"
  done

  for profile_dir in "${dotfiles}"/claude/profiles/*/; do
    profile="${profile_dir%/}"
    profile="${profile##*/}"

    config_dir="${XDG_CONFIG_HOME}/claude-${profile}"
    [ "${profile}" != default ] || config_dir="${CLAUDE_CONFIG_DIR}"
    make_dirs "${config_dir}"

    [ -L "${config_dir}/settings.json" ] ||
      remove "${config_dir}/settings.json"
    for conf in settings.json CLAUDE.md statusline-command.sh hooks; do
      symlink "${dotfiles}/claude/${conf}" "${config_dir}/${conf}"
    done

    for conf in mcp.json settings.json; do
      [ -e "${profile_dir}${conf}" ] ||
        conflict "The ${profile} profile cannot start, ${profile_dir}${conf} does not exist."
    done
    find "${profile_dir}" -type l | while read -r link; do
      [ -e "${link}" ] ||
        conflict "The ${profile} profile links ${link#"${profile_dir}"} to $(readlink "${link}"), which does not exist."
    done
    symlink "${profile_dir%/}" "${config_dir}/profile"
    symlink "${profile_dir%/}/rules" "${config_dir}/rules"

    state="${config_dir}/.claude.json"
    current_names="$(jq -r '.mcpServers // {} | keys[]' "${state}" 2>/dev/null || :)"

    for name in ${current_names}; do
      CLAUDE_CONFIG_DIR="${config_dir}" claude mcp remove --scope user "${name}" >/dev/null
      printf '%s\n' "Removed Claude MCP server ${name} from ${config_dir##*/}."
    done
  done
)

configure_rustup() {
  migrate "${HOME}/.rustup" "${RUSTUP_HOME}"
}

configure_cargo() {
  migrate "${HOME}/.cargo" "${CARGO_HOME}"
}

configure_npm() {
  symlink "${dotfiles}/npm" "${XDG_CONFIG_HOME}/npm"
  remove "${HOME}/.npm"
}

configure_bun() {
  migrate "${HOME}/.bun" "${BUN_INSTALL}"
  migrate "${HOME}/.bunfig.toml" "${XDG_CONFIG_HOME}/.bunfig.toml"
  remove "${BUN_INSTALL}/install/cache"

  for link in "${BUN_INSTALL}"/bin/*; do
    [ -L "${link}" ] || continue
    symlink "$(readlink -f "${link}")" "${BUN_INSTALL_BIN}/${link##*/}"
  done
}

configure_docker() {
  migrate "${HOME}/.docker" "${DOCKER_CONFIG}"
  migrate "${DOCKER_CONFIG}/buildx" "${BUILDX_CONFIG}"
}

configure_colima() {
  if [ -e "${HOME}/.colima" ] || [ -e "${HOME}/.lima" ]; then
    if pgrep -q -x limactl; then
      conflict "Not moving ${HOME}/.colima or ${HOME}/.lima while a VM is running, stop it first."
      return 0
    fi
  fi

  migrate "${HOME}/.colima" "${COLIMA_HOME}"
  migrate "${COLIMA_HOME}/_lima" "${LIMA_HOME}"
  migrate "${HOME}/.lima" "${LIMA_HOME}"
}

configure_aws() {
  migrate "${HOME}/.aws" "${AWS_CONFIG_FILE%/*}"
}

configure_kubectl() {
  migrate "${HOME}/.kube/config" "${KUBECONFIG}"
  make_dirs "${KUBECONFIG%/*}" "${KUBECACHEDIR}"
}

configure_codex() {
  migrate "${HOME}/.codex" "${CODEX_HOME}"
  make_dirs "${CODEX_HOME}"
}

configure_syncthing() (
  env_file="${XDG_CONFIG_HOME}/homebrew/services/syncthing.env"
  default_home="${HOME}/Library/Application Support/Syncthing"
  ignores="${dotfiles}/syncthing/ignores"

  if [ "$(cat "${env_file}" 2>/dev/null)" != "STHOMEDIR=${STHOMEDIR}" ]; then
    make_dirs "${env_file%/*}"
    printf 'STHOMEDIR=%s\n' "${STHOMEDIR}" >"${env_file}"
    printf '%s\n' "Wrote ${env_file}."
  fi

  if [ -e "${default_home}" ]; then
    brew services stop syncthing
    migrate "${default_home}" "${STHOMEDIR}"
    brew services start syncthing
    sleep 2
  fi

  if ! syncthing cli config options uraccepted get >/dev/null 2>&1; then
    conflict "Syncthing is not responding, run install again once it has started."
    return 0
  fi

  while read -r option value; do
    [ "$(syncthing cli config options "${option}" get)" != "${value}" ] || continue
    syncthing cli config options "${option}" set -- "${value}"
    printf '%s\n' "Set Syncthing ${option} to ${value}."
  done <"${dotfiles}/syncthing/options"

  while read -r option value; do
    [ "$(syncthing cli config defaults folder "${option}" get)" != "${value}" ] || continue
    syncthing cli config defaults folder "${option}" set -- "${value}"
    printf '%s\n' "Set Syncthing default folder ${option} to ${value}."
  done <"${dotfiles}/syncthing/folder"

  while read -r option value; do
    [ "$(syncthing cli config defaults device "${option}" get)" != "${value}" ] || continue
    syncthing cli config defaults device "${option}" set -- "${value}"
    printf '%s\n' "Set Syncthing default device ${option} to ${value}."
  done <"${dotfiles}/syncthing/device"

  if [ "$(syncthing cli config defaults ignores dump-json | jq -r '.lines[]')" != "$(cat "${ignores}")" ]; then
    syncthing cli operations default-ignores "${ignores}"
    printf '%s\n' "Set Syncthing default ignores."
  fi

  while read -r device name address; do
    ! syncthing cli config devices list | grep -Fqx "${device}" || continue
    syncthing cli config devices add --device-id "${device}" --name "${name}" --addresses "${address}"
    printf '%s\n' "Added Syncthing device ${name}."
  done <"${dotfiles}/syncthing/devices"

  while read -r id path label; do
    symlink "${ignores}" "${HOME}/${path}/.stignore"

    # shellcheck disable=SC2088
    if ! syncthing cli config folders list | grep -Fqx "${id}"; then
      syncthing cli config folders add --id "${id}" --path "~/${path}" --label "${label}"
      printf '%s\n' "Added Syncthing folder ${id}."
    fi

    # shellcheck disable=SC2088
    if [ "$(syncthing cli config folders "${id}" path get)" != "~/${path}" ]; then
      syncthing cli config folders "${id}" path set -- "~/${path}"
      printf '%s\n' "Set Syncthing folder ${id} path to ~/${path}."
    fi

    if [ "$(syncthing cli config folders "${id}" label get)" != "${label}" ]; then
      syncthing cli config folders "${id}" label set -- "${label}"
      printf '%s\n' "Set Syncthing folder ${id} label to ${label}."
    fi

    while read -r device _; do
      ! syncthing cli config folders "${id}" devices list | grep -Fqx "${device}" || continue
      syncthing cli config folders "${id}" devices add --device-id "${device}"
      printf '%s\n' "Shared Syncthing folder ${id} with ${device}."
    done <"${dotfiles}/syncthing/devices"
  done <"${dotfiles}/syncthing/folders"
)

configure_macos() (
  errors="$(mktemp)"

  if ! "${dotfiles}/macos/defaults" 2>"${errors}"; then
    conflict "$(cat "${errors}")"
  fi

  rm -f "${errors}"
)

github_authenticates() {
  printf '%s\n' "Touch the YubiKey to authenticate with GitHub."
  ssh -T -o StrictHostKeyChecking=accept-new git@github.com 2>&1 | grep -q 'successfully authenticated'
}

configure_ssh() (
  remote="git@github.com:${repo}.git"

  symlink "${dotfiles}/ssh/config" "${HOME}/.ssh/config"

  [ "$(git -C "${dotfiles}" remote get-url origin)" != "${remote}" ] || return 0

  if github_authenticates; then
    git -C "${dotfiles}" remote set-url origin "${remote}"
    printf '%s\n' "Set origin to ${remote}."
  else
    conflict "GitHub rejected the SSH key, register the YubiKey's key at https://github.com/settings/keys."
  fi
)

main() {
  conflicts="$(mktemp)"
  readonly conflicts
  trap 'rm -f "${conflicts}"' EXIT
  trap 'exit 1' INT TERM HUP

  require_full_disk_access
  ask_questions
  clone_dotfiles
  load_environment

  configure_host
  configure_homebrew
  pull_ssh_keys
  configure_zsh
  configure_editorconfig

  for tool in \
    aws \
    bun \
    bundle \
    cargo \
    claude \
    codex \
    colima \
    docker \
    gh \
    ghostty \
    git \
    go \
    gpg \
    kubectl \
    less \
    npm \
    nvim \
    pass \
    python3 \
    rustup \
    syncthing \
    terraform \
    tflint \
    vim \
    yamlfmt \
    yamllint; do
    command -v "${tool}" >/dev/null || continue
    "configure_${tool}"
  done

  configure_macos
  configure_ssh

  if [ -s "${conflicts}" ]; then
    printf '\n%s\n' "Resolve these by hand:" >&2
    cat "${conflicts}" >&2
    printf '\n%s\n' "Then run install again:" "  ${dotfiles}/install" >&2
    return 1
  fi
}

main "$@"
