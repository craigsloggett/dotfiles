#!/bin/sh
#
# install dot files

set -eu

# Global Variables
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_BIN_HOME:=${HOME}/.local/bin}"

# Get the full path of the current working directory.
dirname="$(cd "${0%/*}" && printf '%s\n' "${PWD}")"
readonly dirname

conflict() {
  printf '%s\n' "$*" | tee -a "${conflicts}" >&2
}

symlink() (
  source="${1:?a symlink source is required}"
  target="${2:?a symlink target is required}"

  [ -e "${source}" ] || return 0
  [ "$(readlink "${target}")" != "${source}" ] || return 0

  if [ -e "${target}" ] && [ ! -L "${target}" ]; then
    conflict "Not linking ${target}, it already exists."
    return 0
  fi

  mkdir -p "${target%/*}"
  ln -sfn "${source}" "${target}"
  printf '%s\n' "Linked ${target} to ${source}."
)

make_dirs() {
  for dir in "$@"; do
    if [ ! -d "${dir}" ]; then
      mkdir -p "${dir}"
      printf '%s\n' "Created ${dir}."
    fi
  done
}

migrate() (
  source="${1:?a migration source is required}"
  target="${2:?a migration target is required}"

  [ -e "${source}" ] || return 0

  if [ -e "${target}" ]; then
    conflict "Not moving ${source}, ${target} already exists."
    return 0
  fi

  mkdir -p "${target%/*}"
  mv "${source}" "${target}"
  printf '%s\n' "Moved ${source} to ${target}."
)

merge_history() (
  source="${1:?a history source is required}"
  target="${2:?a history target is required}"

  [ -e "${source}" ] || return 0

  if [ -e "${target}" ]; then
    cat "${target}" >>"${source}"
  fi

  mkdir -p "${target%/*}"
  mv "${source}" "${target}"
  printf '%s\n' "Merged ${source} into ${target}."
)

remove() {
  for file in "$@"; do
    if [ -e "${file}" ]; then
      rm -rf "${file}"
      printf '%s\n' "Removed ${file}."
    fi
  done
}

ask() (
  prompt="${1:?a prompt is required}"

  printf '%s: ' "${prompt}" >&2
  read -r answer || answer=''
  printf '%s\n' "${answer}"
)

load_environment() {
  for file in "${dirname}"/zsh/.zprofile.d/*.sh; do
    # shellcheck source=/dev/null
    . "${file}"
  done
}

zshenv() {
  cat <<'EOF'
export ZDOTDIR="${XDG_CONFIG_HOME:-${HOME}/.config}/zsh"
EOF
}

configure_zsh() {
  if [ "$(cat /etc/zshenv 2>/dev/null)" != "$(zshenv)" ]; then
    zshenv | sudo tee /etc/zshenv >/dev/null
    printf '%s\n' "Wrote /etc/zshenv."
  fi

  symlink "${dirname}/zsh" "${XDG_CONFIG_HOME}/zsh"
  make_dirs "${XDG_STATE_HOME}/zsh" "${XDG_CACHE_HOME}/zsh"
  merge_history "${HOME}/.zsh_history" "${XDG_STATE_HOME}/zsh/history"
  remove "${HOME}/.zcompdump" "${HOME}/.zsh_sessions" "${HOME}/.zprofile" "${HOME}/.zshrc"
}

configure_vim() {
  symlink "${dirname}/vim" "${XDG_CONFIG_HOME}/vim"
  migrate "${HOME}/.viminfo" "${XDG_STATE_HOME}/vim/viminfo"
  make_dirs \
    "${XDG_STATE_HOME}/vim" \
    "${XDG_DATA_HOME}/vim/spell" \
    "${XDG_DATA_HOME}/vim/view" \
    "${XDG_CACHE_HOME}/vim/backup" \
    "${XDG_CACHE_HOME}/vim/swap" \
    "${XDG_CACHE_HOME}/vim/undo"
}

configure_nvim() {
  symlink "${dirname}/nvim" "${XDG_CONFIG_HOME}/nvim"
}

configure_git() (
  personal="${XDG_CONFIG_HOME}/git/config-personal"

  symlink "${dirname}/git" "${XDG_CONFIG_HOME}/git"
  migrate "${HOME}/.gitconfig" "${personal}"

  [ -z "$(git config --file "${personal}" user.email)" ] || return 0

  email="$(ask 'Email address for Git commits')"

  if [ -z "${email}" ]; then
    conflict "No Git email set, add user.email to ${personal}."
    return 0
  fi

  git config --file "${personal}" user.email "${email}"
  printf '%s\n' "Set user.email in ${personal}."
)

configure_gpg() {
  migrate "${HOME}/.gnupg" "${XDG_DATA_HOME}/gnupg"
  make_dirs "${XDG_DATA_HOME}/gnupg"
  chmod 700 "${XDG_DATA_HOME}/gnupg"

  for conf in gpg.conf gpg-agent.conf; do
    symlink "${dirname}/gnupg/${conf}" "${XDG_DATA_HOME}/gnupg/${conf}"
  done
}

configure_go() {
  migrate "${HOME}/go" "${GOPATH}"

  for binary in "${GOPATH}"/bin/*; do
    [ -e "${binary}" ] || continue
    migrate "${binary}" "${GOBIN}/${binary##*/}"
  done

  if [ -d "${GOPATH}/bin" ] && [ -z "$(ls -A "${GOPATH}/bin")" ]; then
    rmdir "${GOPATH}/bin"
    printf '%s\n' "Removed ${GOPATH}/bin."
  fi
}

configure_pass() {
  migrate "${HOME}/.password-store" "${PASSWORD_STORE_DIR}"
}

configure_less() {
  migrate "${HOME}/.lesshst" "${LESSHISTFILE}"
  make_dirs "${LESSHISTFILE%/*}"
}

configure_python() {
  migrate "${HOME}/.python_history" "${PYTHON_HISTORY}"
  make_dirs "${PYTHON_HISTORY%/*}"
}

configure_tmux() {
  symlink "${dirname}/tmux" "${XDG_CONFIG_HOME}/tmux"
}

configure_terraform() {
  symlink "${dirname}/terraform" "${XDG_CONFIG_HOME}/terraform"
  make_dirs "${XDG_CACHE_HOME}/terraform"
}

configure_tflint() {
  symlink "${dirname}/tflint" "${XDG_CONFIG_HOME}/tflint"
  migrate "${HOME}/.tflint.d" "${XDG_DATA_HOME}/tflint"
  make_dirs "${XDG_DATA_HOME}/tflint"
}

configure_yamllint() {
  symlink "${dirname}/yamllint" "${XDG_CONFIG_HOME}/yamllint"
}

configure_yamlfmt() {
  symlink "${dirname}/yamlfmt" "${XDG_CONFIG_HOME}/yamlfmt"
}

configure_ghostty() {
  # Setup directories.
  mkdir -p "${XDG_DATA_HOME}"
  mkdir -p "${XDG_CONFIG_HOME}"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/ghostty" "${XDG_CONFIG_HOME}/ghostty"

  # Migrate existing data, otherwise setup the directory.
  if [ -d "${HOME}/.terminfo" ]; then
    mv "${HOME}/.terminfo" "${XDG_DATA_HOME}/terminfo"
  else
    mkdir -p "${XDG_DATA_HOME}/terminfo"
  fi

  for terminfo in 67 78; do
    symlink "/Applications/Ghostty.app/Contents/Resources/terminfo/${terminfo}" "${XDG_DATA_HOME}/terminfo/${terminfo}"
  done
}

configure_claude() {
  # Migrate an existing installation.
  if [ -d "${HOME}/.claude" ] && [ ! -h "${HOME}/.claude" ]; then
    if [ -e "${XDG_CONFIG_HOME}/claude" ]; then
      conflict "Both ${HOME}/.claude and ${XDG_CONFIG_HOME}/claude exist, merge them by hand."
      return 0
    fi

    mkdir -p "${XDG_CONFIG_HOME}"
    mv "${HOME}/.claude" "${XDG_CONFIG_HOME}/claude"
  fi

  if [ -f "${HOME}/.claude.json" ] && [ ! -e "${XDG_CONFIG_HOME}/claude/.claude.json" ]; then
    mkdir -p "${XDG_CONFIG_HOME}/claude"
    mv "${HOME}/.claude.json" "${XDG_CONFIG_HOME}/claude/.claude.json"
  fi

  if [ -d "${XDG_CONFIG_HOME}/claude/plugins" ] && [ ! -e "${XDG_DATA_HOME}/claude/plugins" ]; then
    mkdir -p "${XDG_DATA_HOME}/claude"
    mv "${XDG_CONFIG_HOME}/claude/plugins" "${XDG_DATA_HOME}/claude/plugins"
  fi

  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}/claude"
  mkdir -p "${XDG_DATA_HOME}/claude/plugins"

  # Preserve configuration that is not already symlinked to the repository.
  for conf in settings.json CLAUDE.md; do
    if [ -f "${XDG_CONFIG_HOME}/claude/${conf}" ] && [ ! -h "${XDG_CONFIG_HOME}/claude/${conf}" ]; then
      if [ -f "${dirname}/claude/${conf}" ]; then
        mv "${XDG_CONFIG_HOME}/claude/${conf}" "${dirname}/claude/${conf}.backup"
      else
        mv "${XDG_CONFIG_HOME}/claude/${conf}" "${dirname}/claude/${conf}"
      fi
    fi
  done

  # Symlink the configuration to the git repository.
  for conf in settings.json CLAUDE.md statusline-command.sh; do
    if [ -f "${dirname}/claude/${conf}" ]; then
      ln -sf "${dirname}/claude/${conf}" "${XDG_CONFIG_HOME}/claude/${conf}"
    fi
  done

  for conf in agents hooks rules skills; do
    [ -d "${dirname}/claude/${conf}" ] || continue

    if [ -d "${XDG_CONFIG_HOME}/claude/${conf}" ] && [ ! -h "${XDG_CONFIG_HOME}/claude/${conf}" ]; then
      conflict "${XDG_CONFIG_HOME}/claude/${conf} is a directory, merge it into ${dirname}/claude/${conf} by hand."
      return 0
    fi

    ln -sfn "${dirname}/claude/${conf}" "${XDG_CONFIG_HOME}/claude/${conf}"
  done
}

configure_rustup() {
  migrate "${HOME}/.rustup" "${RUSTUP_HOME}"
}

configure_cargo() {
  migrate "${HOME}/.cargo" "${CARGO_HOME}"
}

configure_npm() {
  symlink "${dirname}/npm" "${XDG_CONFIG_HOME}/npm"
  remove "${HOME}/.npm"
}

configure_bun() {
  migrate "${HOME}/.bun" "${BUN_INSTALL}"
  migrate "${HOME}/.bunfig.toml" "${XDG_CONFIG_HOME}/.bunfig.toml"
  remove "${BUN_INSTALL}/install/cache"

  for link in "${BUN_INSTALL}"/bin/*; do
    [ -L "${link}" ] || continue
    symlink "$(readlink -f "${link}")" "${BUN_INSTALL_BIN}/${link##*/}"
  done
}

configure_docker() {
  migrate "${HOME}/.docker" "${DOCKER_CONFIG}"
  migrate "${DOCKER_CONFIG}/buildx" "${BUILDX_CONFIG}"
}

configure_colima() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_DATA_HOME}/lima"

  # Migrate existing config if it exists.
  if [ -d "${HOME}/.colima" ]; then
    mv "${HOME}/.colima" "${XDG_CONFIG_HOME}/colima"
  fi

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/colima" "${XDG_CONFIG_HOME}/colima"

  # Remove the ~/.colima directory if it is empty.
  if [ -d "${HOME}/.colima" ]; then
    if [ -z "$(ls -A "${HOME}/.colima")" ]; then
      rmdir "${HOME}/.colima"
    fi
  fi
}

configure_aws() {
  migrate "${HOME}/.aws" "${AWS_CONFIG_FILE%/*}"
}

configure_kubectl() {
  migrate "${HOME}/.kube/config" "${KUBECONFIG}"
  make_dirs "${KUBECONFIG%/*}" "${KUBECACHEDIR}"
}

configure_codex() {
  migrate "${HOME}/.codex" "${CODEX_HOME}"
  make_dirs "${CODEX_HOME}"
}

main() {
  conflicts="$(mktemp)"
  readonly conflicts
  trap 'rm -f "${conflicts}"' EXIT
  trap 'exit 1' INT TERM HUP

  load_environment

  configure_zsh
  configure_vim
  configure_nvim
  configure_git
  configure_gpg
  configure_go
  configure_pass
  configure_less
  configure_python
  configure_tmux
  configure_terraform
  configure_tflint
  configure_yamllint
  configure_yamlfmt
  configure_ghostty
  configure_claude
  configure_rustup
  configure_cargo
  configure_npm
  configure_bun
  configure_docker
  configure_colima
  configure_aws
  configure_kubectl
  configure_codex

  if [ -s "${conflicts}" ]; then
    printf '\n%s\n' "Resolve these by hand, then run install again:" >&2
    cat "${conflicts}" >&2
    return 1
  fi
}

main "$@"
