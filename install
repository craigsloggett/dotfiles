#!/bin/sh
#
# install dot files

# Global Variables
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"

# Get the full path of the current working directory.
dirname="$(cd "${0%/*}" && printf '%s\n' "${PWD}")"
readonly dirname

symlink() (
  source="${1:?a symlink source is required}"
  target="${2:?a symlink target is required}"

  [ -e "${source}" ] || return 0
  [ "$(readlink "${target}")" != "${source}" ] || return 0

  if [ -e "${target}" ] && [ ! -L "${target}" ]; then
    printf '%s\n' "Not linking ${target}, it already exists." >&2
    return 1
  fi

  mkdir -p "${target%/*}"
  ln -sfn "${source}" "${target}"
  printf '%s\n' "Linked ${target} to ${source}."
)

make_dirs() {
  for dir in "$@"; do
    if [ ! -d "${dir}" ]; then
      mkdir -p "${dir}"
      printf '%s\n' "Created ${dir}."
    fi
  done
}

migrate() (
  source="${1:?a migration source is required}"
  target="${2:?a migration target is required}"

  [ -e "${source}" ] || return 0

  if [ -e "${target}" ]; then
    printf '%s\n' "Not moving ${source}, ${target} already exists." >&2
    return 1
  fi

  mkdir -p "${target%/*}"
  mv "${source}" "${target}"
  printf '%s\n' "Moved ${source} to ${target}."
)

merge_history() (
  source="${1:?a history source is required}"
  target="${2:?a history target is required}"

  [ -e "${source}" ] || return 0

  if [ -e "${target}" ]; then
    cat "${target}" >>"${source}"
  fi

  mkdir -p "${target%/*}"
  mv "${source}" "${target}"
  printf '%s\n' "Merged ${source} into ${target}."
)

remove() {
  for file in "$@"; do
    if [ -e "${file}" ]; then
      rm -rf "${file}"
      printf '%s\n' "Removed ${file}."
    fi
  done
}

zshenv() {
  cat <<'EOF'
export ZDOTDIR="${XDG_CONFIG_HOME:-${HOME}/.config}/zsh"
EOF
}

configure_zsh() {
  if [ "$(cat /etc/zshenv 2>/dev/null)" != "$(zshenv)" ]; then
    zshenv | sudo tee /etc/zshenv >/dev/null
    printf '%s\n' "Wrote /etc/zshenv."
  fi

  symlink "${dirname}/zsh" "${XDG_CONFIG_HOME}/zsh"
  make_dirs "${XDG_STATE_HOME}/zsh" "${XDG_CACHE_HOME}/zsh"
  merge_history "${HOME}/.zsh_history" "${XDG_STATE_HOME}/zsh/history"
  remove "${HOME}/.zcompdump" "${HOME}/.zsh_sessions" "${HOME}/.zprofile" "${HOME}/.zshrc"
}

configure_vim() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_STATE_HOME}/vim"
  mkdir -p "${XDG_DATA_HOME}/vim/spell"
  mkdir -p "${XDG_DATA_HOME}/vim/view"
  mkdir -p "${XDG_CACHE_HOME}/vim/backup"
  mkdir -p "${XDG_CACHE_HOME}/vim/swap"
  mkdir -p "${XDG_CACHE_HOME}/vim/undo"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/vim" "${XDG_CONFIG_HOME}/vim"

  # Cleanup
  rm -f "${HOME}/.viminfo"
}

configure_nvim() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_STATE_HOME}/nvim"
  mkdir -p "${XDG_DATA_HOME}/nvim"
  mkdir -p "${XDG_CACHE_HOME}/nvim"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/nvim" "${XDG_CONFIG_HOME}/nvim"
}

configure_git() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/git" "${XDG_CONFIG_HOME}/git"

  # Migrate existing git configuration.
  if [ -f "${HOME}/.gitconfig" ]; then
    mv "${HOME}/.gitconfig" "${XDG_CONFIG_HOME}/git/config"
  fi
}

configure_gpg() {
  migrate "${HOME}/.gnupg" "${XDG_DATA_HOME}/gnupg"
  make_dirs "${XDG_DATA_HOME}/gnupg"
  chmod 700 "${XDG_DATA_HOME}/gnupg"

  for conf in gpg.conf gpg-agent.conf; do
    symlink "${dirname}/gnupg/${conf}" "${XDG_DATA_HOME}/gnupg/${conf}"
  done
}

configure_go() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}/go"
  mkdir -p "${XDG_DATA_HOME}/go/bin"
  mkdir -p "${XDG_CACHE_HOME}/go"

  if [ -d "${XDG_CACHE_HOME}/go/bin" ]; then
    for binary in "${XDG_CACHE_HOME}/go/bin"/*; do
      [ -f "${binary}" ] || continue
      mv "${binary}" "${XDG_DATA_HOME}/go/bin"
    done

    if [ -z "$(ls -A "${XDG_CACHE_HOME}/go/bin")" ]; then
      rmdir "${XDG_CACHE_HOME}/go/bin"
    fi
  fi
}

configure_pass() {
  # Migrate existing password store, otherwise setup the directory.
  if [ -d "${HOME}/.password-store" ]; then
    mv "${HOME}/.password-store" "${XDG_DATA_HOME}/pass"
  else
    mkdir -p "${XDG_DATA_HOME}/pass"
  fi
}

configure_less() {
  # Setup directories.
  mkdir -p "${XDG_STATE_HOME}/less"

  # Preserve existing history file.
  if [ -f "${HOME}/.lesshst" ]; then
    mv "${HOME}/.lesshst" "${XDG_STATE_HOME}/less/lesshst"
  fi
}

configure_python() {
  # Setup directories.
  mkdir -p "${XDG_STATE_HOME}/python"
  mkdir -p "${XDG_CACHE_HOME}/python"
  mkdir -p "${XDG_DATA_HOME}/python"

  # Preserve existing history file.
  if [ -f "${HOME}/.python_history" ]; then
    mv "${HOME}/.python_history" "${XDG_STATE_HOME}/python/history"
  fi
}

configure_tmux() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/tmux" "${XDG_CONFIG_HOME}/tmux"
}

configure_terraform() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_CACHE_HOME}/terraform"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/terraform" "${XDG_CONFIG_HOME}/terraform"
}

configure_tflint() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"

  # Migrate existing data, otherwise setup the directory.
  if [ -d "${HOME}/.tflint.d" ]; then
    mv "${HOME}/.tflint.d" "${XDG_DATA_HOME}/tflint"
  else
    mkdir -p "${XDG_DATA_HOME}/tflint"
  fi

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/tflint" "${XDG_CONFIG_HOME}/tflint"
}

configure_yamllint() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/yamllint" "${XDG_CONFIG_HOME}/yamllint"
}

configure_yamlfmt() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/yamlfmt" "${XDG_CONFIG_HOME}/yamlfmt"
}

configure_ruff() {
  # Setup directories.
  mkdir -p "${XDG_CACHE_HOME}/ruff"
}

configure_ghostty() {
  # Setup directories.
  mkdir -p "${XDG_DATA_HOME}"
  mkdir -p "${XDG_CONFIG_HOME}"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/ghostty" "${XDG_CONFIG_HOME}/ghostty"

  # Migrate existing data, otherwise setup the directory.
  if [ -d "${HOME}/.terminfo" ]; then
    mv "${HOME}/.terminfo" "${XDG_DATA_HOME}/terminfo"
  else
    mkdir -p "${XDG_DATA_HOME}/terminfo"
  fi

  for terminfo in 67 78; do
    symlink "/Applications/Ghostty.app/Contents/Resources/terminfo/${terminfo}" "${XDG_DATA_HOME}/terminfo/${terminfo}"
  done
}

configure_claude() {
  # Migrate an existing installation.
  if [ -d "${HOME}/.claude" ] && [ ! -h "${HOME}/.claude" ]; then
    if [ -e "${XDG_CONFIG_HOME}/claude" ]; then
      printf '%s\n' "Both ${HOME}/.claude and ${XDG_CONFIG_HOME}/claude exist, merge them by hand." >&2
      return 1
    fi

    mkdir -p "${XDG_CONFIG_HOME}"
    mv "${HOME}/.claude" "${XDG_CONFIG_HOME}/claude"
  fi

  if [ -f "${HOME}/.claude.json" ] && [ ! -e "${XDG_CONFIG_HOME}/claude/.claude.json" ]; then
    mkdir -p "${XDG_CONFIG_HOME}/claude"
    mv "${HOME}/.claude.json" "${XDG_CONFIG_HOME}/claude/.claude.json"
  fi

  if [ -d "${XDG_CONFIG_HOME}/claude/plugins" ] && [ ! -e "${XDG_DATA_HOME}/claude/plugins" ]; then
    mkdir -p "${XDG_DATA_HOME}/claude"
    mv "${XDG_CONFIG_HOME}/claude/plugins" "${XDG_DATA_HOME}/claude/plugins"
  fi

  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}/claude"
  mkdir -p "${XDG_DATA_HOME}/claude/plugins"

  # Preserve configuration that is not already symlinked to the repository.
  for conf in settings.json CLAUDE.md; do
    if [ -f "${XDG_CONFIG_HOME}/claude/${conf}" ] && [ ! -h "${XDG_CONFIG_HOME}/claude/${conf}" ]; then
      if [ -f "${dirname}/claude/${conf}" ]; then
        mv "${XDG_CONFIG_HOME}/claude/${conf}" "${dirname}/claude/${conf}.backup"
      else
        mv "${XDG_CONFIG_HOME}/claude/${conf}" "${dirname}/claude/${conf}"
      fi
    fi
  done

  # Symlink the configuration to the git repository.
  for conf in settings.json CLAUDE.md statusline-command.sh; do
    if [ -f "${dirname}/claude/${conf}" ]; then
      ln -sf "${dirname}/claude/${conf}" "${XDG_CONFIG_HOME}/claude/${conf}"
    fi
  done

  for conf in agents hooks rules skills; do
    [ -d "${dirname}/claude/${conf}" ] || continue

    if [ -d "${XDG_CONFIG_HOME}/claude/${conf}" ] && [ ! -h "${XDG_CONFIG_HOME}/claude/${conf}" ]; then
      printf '%s\n' "${XDG_CONFIG_HOME}/claude/${conf} is a directory, merge it into ${dirname}/claude/${conf} by hand." >&2
      return 1
    fi

    ln -sfn "${dirname}/claude/${conf}" "${XDG_CONFIG_HOME}/claude/${conf}"
  done
}

configure_irssi() {
  # Setup directories.
  mkdir -p "${XDG_DATA_HOME}"
  mkdir -p "${XDG_CONFIG_HOME}"

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/irssi" "${XDG_CONFIG_HOME}/irssi"

  # Migrate existing configuration, otherwise setup the directory.
  if [ -d "${HOME}/.irssi" ]; then
    if [ -f "${HOME}/.irssi/config" ]; then
      mv "${HOME}/.irssi/config" "${XDG_CONFIG_HOME}/irssi"
      rm -rf "${HOME}/.irssi"
    fi
  fi

  # Create the data directory.
  mkdir -p "${XDG_DATA_HOME}/irssi"
}

configure_rustup() {
  # Setup directories.
  mkdir -p "${XDG_DATA_HOME}"

  # Migrate existing data, otherwise create the data directory.
  if [ -d "${HOME}/.rustup" ]; then
    mv "${HOME}/.rustup" "${XDG_DATA_HOME}/rustup"
    rm -rf "${HOME}/.rustup"
  else
    mkdir -p "${XDG_DATA_HOME}/rustup"
  fi
}

configure_cargo() {
  # Create the data directory.
  mkdir -p "${XDG_DATA_HOME}/cargo"
}

configure_npm() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_DATA_HOME}/npm"
  mkdir -p "${XDG_CACHE_HOME}/npm"
  mkdir -p "${XDG_STATE_HOME}/npm"

  # Migrate existing logs, otherwise create the logs directory.
  if [ -d "${HOME}/.npm/_logs" ]; then
    mv "${HOME}/.npm/_logs" "${XDG_STATE_HOME}/npm/logs"
  else
    mkdir -p "${XDG_STATE_HOME}/npm/logs"
  fi

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/npm" "${XDG_CONFIG_HOME}/npm"

  # Remove the ~/.npm directory if it is empty.
  if [ -d "${HOME}/.npm" ]; then
    if [ -z "$(ls -A "${HOME}/.npm")" ]; then
      rm -rf "${HOME}/.npm"
    fi
  fi
}

configure_bun() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_CACHE_HOME}/bun"
  mkdir -p "${XDG_DATA_HOME}"

  # Migrate existing data, otherwise setup the directory.
  if [ -d "${HOME}/.bun" ]; then
    mv "${HOME}/.bun" "${XDG_DATA_HOME}/bun"
  else
    mkdir -p "${XDG_DATA_HOME}/bun"
  fi

  # Migrate existing global config.
  if [ -f "${HOME}/.bunfig.toml" ]; then
    mv "${HOME}/.bunfig.toml" "${XDG_CONFIG_HOME}/.bunfig.toml"
  fi
}

configure_docker() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_STATE_HOME}/docker/buildx"

  # Migrate existing config if it exists.
  if [ -d "${HOME}/.docker" ]; then
    mv "${HOME}/.docker" "${XDG_CONFIG_HOME}/docker"
  fi

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/docker" "${XDG_CONFIG_HOME}/docker"

  # Remove the ~/.docker directory if it is empty.
  if [ -d "${HOME}/.docker" ]; then
    if [ -z "$(ls -A "${HOME}/.docker")" ]; then
      rmdir "${HOME}/.docker"
    fi
  fi
}

configure_colima() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"
  mkdir -p "${XDG_DATA_HOME}/lima"

  # Migrate existing config if it exists.
  if [ -d "${HOME}/.colima" ]; then
    mv "${HOME}/.colima" "${XDG_CONFIG_HOME}/colima"
  fi

  # Symlink dotfiles to the git repository.
  symlink "${dirname}/colima" "${XDG_CONFIG_HOME}/colima"

  # Remove the ~/.colima directory if it is empty.
  if [ -d "${HOME}/.colima" ]; then
    if [ -z "$(ls -A "${HOME}/.colima")" ]; then
      rmdir "${HOME}/.colima"
    fi
  fi
}

configure_aws() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"

  # Migrate existing credentials, otherwise setup the directory.
  if [ -d "${HOME}/.aws" ] && [ ! -e "${XDG_CONFIG_HOME}/aws" ]; then
    mv "${HOME}/.aws" "${XDG_CONFIG_HOME}/aws"
  else
    mkdir -p "${XDG_CONFIG_HOME}/aws"
  fi
}

configure_kubectl() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}/kube"
  mkdir -p "${XDG_CACHE_HOME}/kube"

  # Migrate an existing kubeconfig.
  if [ -f "${HOME}/.kube/config" ] && [ ! -e "${XDG_CONFIG_HOME}/kube/config" ]; then
    mv "${HOME}/.kube/config" "${XDG_CONFIG_HOME}/kube/config"
  fi
}

configure_codex() {
  # Setup directories.
  mkdir -p "${XDG_CONFIG_HOME}"

  # Migrate existing configuration, otherwise setup the directory.
  if [ -d "${HOME}/.codex" ] && [ ! -e "${XDG_CONFIG_HOME}/codex" ]; then
    mv "${HOME}/.codex" "${XDG_CONFIG_HOME}/codex"
  else
    mkdir -p "${XDG_CONFIG_HOME}/codex"
  fi
}

main() {
  configure_zsh
  configure_vim
  configure_nvim
  configure_git
  configure_gpg
  configure_go
  configure_pass
  configure_less
  configure_python
  configure_tmux
  configure_terraform
  configure_tflint
  configure_yamllint
  configure_yamlfmt
  configure_ruff
  configure_ghostty
  configure_claude
  configure_irssi
  configure_rustup
  configure_cargo
  configure_npm
  configure_bun
  configure_docker
  configure_colima
  configure_aws
  configure_kubectl
  configure_codex
}

main "$@"
