#!/bin/sh

set -eu

CHECK="${CHECK:-}"
readonly CHECK

restarts=''

full_disk_access() {
  ls "${HOME}/Library/Safari" >/dev/null 2>&1
}

changed() {
  case "${1:?a defaults domain is required}" in
    com.apple.dock) restarts="${restarts} Dock" ;;
    com.apple.finder) restarts="${restarts} Finder" ;;
    com.apple.controlcenter | com.apple.menuextra.clock) restarts="${restarts} ControlCenter" ;;
    com.apple.WindowManager) restarts="${restarts} WindowManager" ;;
    com.apple.sharingd) restarts="${restarts} sharingd" ;;
    NSGlobalDomain | com.apple.symbolichotkeys | com.apple.AppleMultitouch* | com.apple.driver.*) restarts="${restarts} logout" ;;
  esac
}

set_default() {
  domain="${1:?a defaults domain is required}"
  key="${2:?a defaults key is required}"
  type="${3:?a defaults type is required}"
  value="${4?a defaults value is required}"

  case "${type}:${value}" in
    bool:true) want=1 ;;
    bool:false) want=0 ;;
    *) want="${value}" ;;
  esac

  case "${type}" in
    bool) kind=boolean ;;
    int) kind=integer ;;
    *) kind="${type}" ;;
  esac

  current="$(defaults read "${domain}" "${key}" 2>/dev/null || :)"

  if [ "${current}" = "${want}" ] && [ "$(defaults read-type "${domain}" "${key}" 2>/dev/null)" = "Type is ${kind}" ]; then
    return 0
  fi

  printf '%s\n' "${domain##*/} ${key}: ${current:-unset} -> ${value}"
  [ -z "${CHECK}" ] || return 0

  case "${domain}" in
    /Library/*) sudo defaults write "${domain}" "${key}" "-${type}" "${value}" ;;
    *) defaults write "${domain}" "${key}" "-${type}" "${value}" ;;
  esac

  changed "${domain}"
}

dock_apps() {
  i=0
  while url="$(defaults export com.apple.dock - | plutil -extract "persistent-apps.${i}.tile-data.file-data._CFURLString" raw -o - - 2>/dev/null)"; do
    printf '%s ' "${url}"
    i=$((i + 1))
  done
}

dock_tile() {
  printf '<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>%s</string><key>_CFURLStringType</key><integer>15</integer></dict></dict><key>tile-type</key><string>file-tile</string></dict>' "${1:?a dock tile url is required}"
}

set_dock_apps() {
  count=$#
  names=''
  want=''
  for app in "$@"; do
    [ -d "${app}" ] || continue
    name="${app##*/}"
    names="${names:+${names}, }${name%.app}"
    url="file://$(printf '%s' "${app}" | sed 's/ /%20/g')/"
    want="${want}${url} "
    set -- "$@" "$(dock_tile "${url}")"
  done
  shift "${count}"

  others="$(defaults export com.apple.dock - | plutil -extract persistent-others.0 raw -o - - 2>/dev/null || :)"
  [ "${want}" != "$(dock_apps)" ] || [ -n "${others}" ] || return 0

  printf '%s\n' "dock persistent-apps -> ${names}"
  [ -z "${CHECK}" ] || return 0

  defaults write com.apple.dock persistent-apps -array "$@"
  defaults write com.apple.dock persistent-others -array
  changed com.apple.dock
}

disable_hotkey() {
  id="${1:?a hotkey id is required}"
  modifiers="${2:?hotkey modifiers are required}"

  enabled="$(defaults export com.apple.symbolichotkeys - | plutil -extract "AppleSymbolicHotKeys.${id}.enabled" raw -o - - 2>/dev/null || :)"
  [ "${enabled}" != false ] || return 0

  printf '%s\n' "symbolichotkeys ${id} enabled: ${enabled:-unset} -> false"
  [ -z "${CHECK}" ] || return 0

  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "${id}" \
    "<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>${modifiers}</integer></array><key>type</key><string>standard</string></dict></dict>"
  changed com.apple.symbolichotkeys
}

set_search_engine() {
  provider="${1:?a search provider identifier is required}"
  name="${2:?a search provider name is required}"

  current="$(defaults export NSGlobalDomain - | plutil -extract NSPreferredWebServices.NSWebServicesProviderWebSearch.NSProviderIdentifier raw -o - - 2>/dev/null || :)"
  [ "${current}" != "${provider}" ] || return 0

  printf '%s\n' "NSPreferredWebServices: ${current:-unset} -> ${provider}"
  [ -z "${CHECK}" ] || return 0

  defaults write NSGlobalDomain NSPreferredWebServices -dict NSWebServicesProviderWebSearch \
    "<dict><key>NSDefaultDisplayName</key><string>${name}</string><key>NSProviderIdentifier</key><string>${provider}</string></dict>"
}

set_screensaver_idle() {
  seconds="${1:?an idle time in seconds is required}"

  current="$(defaults -currentHost read com.apple.screensaver idleTime 2>/dev/null || :)"
  [ "${current}" != "${seconds}" ] || return 0

  printf '%s\n' "screensaver idleTime: ${current:-unset} -> ${seconds}"
  [ -z "${CHECK}" ] || return 0

  defaults -currentHost write com.apple.screensaver idleTime -int "${seconds}"
}

set_screen_lock() {
  seconds="${1:?a lock delay in seconds is required}"

  current="$(sysadminctl -screenLock status 2>&1 | sed 's/.*screenLock //')"
  [ "${current}" != "delay is ${seconds} seconds" ] || return 0

  printf '%s\n' "screenLock: ${current} -> delay is ${seconds} seconds"
  [ -z "${CHECK}" ] || return 0

  sysadminctl -screenLock "${seconds}" -password -
}

