#!/bin/sh

set -eu

CHECK="${CHECK:-}"
readonly CHECK

restarts=''

require_full_disk_access() {
  for dir in Safari Cookies Suggestions Messages; do
    ! ls "${HOME}/Library/${dir}" >/dev/null 2>&1 || return 0
  done

  open 'x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles'
  printf '%s\n' "Turn on Full Disk Access for this terminal in the System Settings pane that just opened, quit and reopen the terminal, then run again." >&2
  return 1
}

container_in_use() {
  defaults -verbose read "${1:?a bundle identifier is required}" 2>&1 | grep -qF "/Containers/${1}/"
}

ensure_container() {
  id="${1:?a bundle identifier is required}"
  app="${2:?an app name is required}"

  ! container_in_use "${id}" || return 0
  [ -z "${CHECK}" ] || return 0

  printf '%s\n' "${app}: opening hidden once so its settings go to its container"
  open -gja "${app}"

  tries=0
  while ! container_in_use "${id}" && [ "${tries}" -lt 30 ]; do
    sleep 1
    tries=$((tries + 1))
  done

  ! pgrep -q -x "${app}" || killall "${app}"

  if ! container_in_use "${id}"; then
    printf '%s\n' "${app} did not start using its settings container, open it once by hand and run again." >&2
    return 1
  fi
}

queue_restart() {
  case "${1:?a defaults domain is required}" in
    com.apple.dock) restarts="${restarts} Dock" ;;
    com.apple.finder) restarts="${restarts} Finder" ;;
    com.apple.controlcenter | com.apple.menuextra.clock) restarts="${restarts} ControlCenter" ;;
    com.apple.WindowManager) restarts="${restarts} WindowManager" ;;
    com.apple.sharingd) restarts="${restarts} sharingd" ;;
    NSGlobalDomain | com.apple.symbolichotkeys | com.apple.AppleMultitouch* | com.apple.driver.*) restarts="${restarts} logout" ;;
  esac
}

restart_changed() {
  for process in "$@"; do
    case " ${restarts} " in
      *" ${process} "*) ;;
      *) continue ;;
    esac

    ! pgrep -q -x "${process}" || killall "${process}"
  done
}

note_logout() {
  case " ${restarts} " in
    *' logout '*) printf '%s\n' "Log out to apply the keyboard, trackpad and mouse settings." ;;
  esac
}

set_default() {
  host=''
  if [ "${1}" = -currentHost ]; then
    host="${1}"
    shift
  fi

  domain="${1:?a defaults domain is required}"
  key="${2:?a defaults key is required}"
  type="${3:?a defaults type is required}"
  value="${4?a defaults value is required}"

  case "${type}:${value}" in
    bool:true) want=1 ;;
    bool:false) want=0 ;;
    *) want="${value}" ;;
  esac

  case "${type}" in
    bool) kind=boolean ;;
    int) kind=integer ;;
    *) kind="${type}" ;;
  esac

  current="$(defaults ${host:+"${host}"} read "${domain}" "${key}" 2>/dev/null || :)"

  if [ "${current}" = "${want}" ] && [ "$(defaults ${host:+"${host}"} read-type "${domain}" "${key}" 2>/dev/null)" = "Type is ${kind}" ]; then
    return 0
  fi

  printf '%s\n' "${domain##*/} ${key}: ${current:-unset} -> ${value}"
  [ -z "${CHECK}" ] || return 0

  case "${domain}" in
    /Library/*)
      sudo -n -v 2>/dev/null || printf '%s\n' "Settings under /Library need sudo access."
      sudo defaults write "${domain}" "${key}" "-${type}" "${value}"
      ;;
    *) defaults ${host:+"${host}"} write "${domain}" "${key}" "-${type}" "${value}" ;;
  esac

  queue_restart "${domain}"
}

set_firewall() {
  option="${1:?a firewall option is required}"
  value="${2:?a firewall value is required}"
  socketfilterfw=/usr/libexec/ApplicationFirewall/socketfilterfw

  if ! answer="$("${socketfilterfw}" "--get${option}")"; then
    printf '%s\n' "socketfilterfw --get${option} failed." >&2
    return 1
  fi

  case "$(printf '%s' "${answer}" | tr '[:upper:]' '[:lower:]')" in
    *disabled* | *' off'*) current=off ;;
    *enabled* | *' on'*) current=on ;;
    *)
      printf '%s\n' "socketfilterfw --get${option} gave an unexpected answer: ${answer}" >&2
      return 1
      ;;
  esac
  [ "${current}" != "${value}" ] || return 0

  printf '%s\n' "firewall ${option}: ${current} -> ${value}"
  [ -z "${CHECK}" ] || return 0

  sudo -n -v 2>/dev/null || printf '%s\n' "Setting the firewall needs sudo access."
  sudo "${socketfilterfw}" "--set${option}" "${value}" >/dev/null
}

dock_app_urls() {
  i=0
  while url="$(defaults export com.apple.dock - | plutil -extract "persistent-apps.${i}.tile-data.file-data._CFURLString" raw -o - - 2>/dev/null)"; do
    printf '%s ' "${url}"
    i=$((i + 1))
  done
}

dock_tile() {
  printf '<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>%s</string><key>_CFURLStringType</key><integer>15</integer></dict></dict><key>tile-type</key><string>file-tile</string></dict>' "${1:?a dock tile url is required}"
}

set_dock_apps() {
  count=$#
  names=''
  want=''
  for app in "$@"; do
    [ -d "${app}" ] || continue
    name="${app##*/}"
    names="${names:+${names}, }${name%.app}"
    url="file://$(printf '%s' "${app}" | sed 's/ /%20/g')/"
    want="${want}${url} "
    set -- "$@" "$(dock_tile "${url}")"
  done
  shift "${count}"

  others="$(defaults export com.apple.dock - | plutil -extract persistent-others.0 raw -o - - 2>/dev/null || :)"
  [ "${want}" != "$(dock_app_urls)" ] || [ -n "${others}" ] || return 0

  printf '%s\n' "dock persistent-apps -> ${names}"
  [ -z "${CHECK}" ] || return 0

  defaults write com.apple.dock persistent-apps -array "$@"
  defaults write com.apple.dock persistent-others -array
  queue_restart com.apple.dock
}

set_screen_lock_delay() {
  seconds="${1:?a lock delay in seconds is required}"

  current="$(sysadminctl -screenLock status 2>&1 | sed 's/.*screenLock //')"
  [ "${current}" != "delay is ${seconds} seconds" ] || return 0

  printf '%s\n' "screenLock: ${current} -> delay is ${seconds} seconds"
  [ -z "${CHECK}" ] || return 0

  printf '%s\n' "Setting the screen lock delay needs your login password."
  sysadminctl -screenLock "${seconds}" -password -
}

disable_keyboard_shortcut() {
  id="${1:?a hotkey id is required}"
  modifiers="${2:?hotkey modifiers are required}"

  enabled="$(defaults export com.apple.symbolichotkeys - | plutil -extract "AppleSymbolicHotKeys.${id}.enabled" raw -o - - 2>/dev/null || :)"
  [ "${enabled}" != false ] || return 0

  printf '%s\n' "symbolichotkeys ${id} enabled: ${enabled:-unset} -> false"
  [ -z "${CHECK}" ] || return 0

  defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "${id}" \
    "<dict><key>enabled</key><false/><key>value</key><dict><key>parameters</key><array><integer>32</integer><integer>49</integer><integer>${modifiers}</integer></array><key>type</key><string>standard</string></dict></dict>"
  queue_restart com.apple.symbolichotkeys
}

set_safari_search_engine() {
  provider="${1:?a search provider identifier is required}"
  name="${2:?a search provider name is required}"

  current="$(defaults export NSGlobalDomain - | plutil -extract NSPreferredWebServices.NSWebServicesProviderWebSearch.NSProviderIdentifier raw -o - - 2>/dev/null || :)"
  [ "${current}" != "${provider}" ] || return 0

  printf '%s\n' "NSPreferredWebServices: ${current:-unset} -> ${provider}"
  [ -z "${CHECK}" ] || return 0

  defaults write NSGlobalDomain NSPreferredWebServices -dict NSWebServicesProviderWebSearch \
    "<dict><key>NSDefaultDisplayName</key><string>${name}</string><key>NSProviderIdentifier</key><string>${provider}</string></dict>"
}

