#!/bin/sh
set -eu

if ! ls "${HOME}/Library/Safari" >/dev/null 2>&1; then
  open 'x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles'
  printf '%s\n' "Turn on Full Disk Access for this terminal in the System Settings pane that just opened, quit and reopen the terminal, then run again." >&2
  exit 1
fi

profile="$(readlink "${XDG_CONFIG_HOME:-${HOME}/.config}/homebrew/Brewfile")"
profile="${profile##*/}"
profile="${profile%.Brewfile}"

write() {
  case "$3 $4" in
    '-bool true') want=1 ;;
    '-bool false') want=0 ;;
    *) want="$4" ;;
  esac

  [ "$(defaults read "$1" "$2" 2>/dev/null)" != "${want}" ] || return 0
  printf '%s %s: %s\n' "$1" "$2" "$4"
  changed=1

  case "$1" in
    /*)
      sudo -n -v 2>/dev/null || printf '%s\n' "Writing $1 needs sudo access."
      sudo defaults write "$@"
      ;;
    *) defaults write "$@" ;;
  esac
}

dock() {
  apps="$*"
  urls=''
  for application in "$@"; do
    directory=/Applications
    if [ -d "/System/Applications/${application}.app" ]; then
      # The App is one of Apple's built-in applications.
      directory=/System/Applications
    else
      directory=/Applications
    fi

    [ -d "${directory}/${application}.app" ] || printf '%s\n' "${application}.app not found" >&2

    url="$(printf 'file://%s/%s.app/' "${directory}" "${application}" | sed 's/ /%20/g')"
    urls="${urls:+${urls} }${url}"
    file_data="<key>_CFURLString</key><string>${url}</string><key>_CFURLStringType</key><integer>15</integer>"
    tile_data="<key>file-data</key><dict>${file_data}</dict>"
    tile="<key>tile-data</key><dict>${tile_data}</dict><key>tile-type</key><string>file-tile</string>"
    set -- "$@" "<dict>${tile}</dict>"
    shift
  done

  current="$({ defaults read com.apple.dock persistent-apps; defaults read com.apple.dock persistent-others; } 2>/dev/null |
    sed -n 's/.*"_CFURLString" = "\(.*\)";/\1/p' | paste -s -d ' ' -)"
  [ "${current}" != "${urls}" ] || return 0

  printf '%s\n' "com.apple.dock persistent-apps: ${apps}"
  defaults write com.apple.dock persistent-apps -array "$@"
  defaults write com.apple.dock persistent-others -array
  killall Dock
}

network_firewall() {
  /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate | grep -q 'State = 1' ||
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on >/dev/null

  /usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode | grep -q 'mode is on' ||
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on >/dev/null
}

