restart() {
  for process in Dock Finder ControlCenter WindowManager sharingd; do
    case " ${restarts} " in
      *" ${process} "*) ;;
      *) continue ;;
    esac

    ! pgrep -q -x "${process}" || killall "${process}"
  done

  case " ${restarts} " in
    *' logout '*) printf '%s\n' "Log out to apply the keyboard, trackpad and mouse settings." ;;
  esac
}

main() {
  if [ "$(uname -s)" != Darwin ]; then
    printf '%s\n' "macos/defaults only runs on macOS." >&2
    return 1
  fi

  language_and_region
  airdrop_and_handoff
  software_update
  time_machine
  accessibility
  appearance
  control_center
  desktop_and_dock
  sound
  lock_screen
  privacy_and_security
  users_and_groups
  siri
  keyboard
  mouse
  trackpad

  finder

  if full_disk_access; then
    safari
    mail
    contacts
  else
    printf '%s\n' "Grant this terminal Full Disk Access in System Settings > Privacy & Security to set up Safari, Mail and Contacts." >&2
  fi

  calendar
  textedit
  activity_monitor
  disk_utility
  screenshot
  terminal
  xcode
  rectangle
  syncthing
  ghostty

  restart
}

main "$@"
