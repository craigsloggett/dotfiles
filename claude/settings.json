{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_CONFIG_DIR}\"/statusline-command.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "voice": {
    "enabled": true
  },
  "agentPushNotifEnabled": false,
  "useAutoModeDuringPlan": false,
  "autoMode": {
    "environment": [
      "$defaults",
      "Both github.com/craigsloggett and github.com/craigsloggett-lab belong to me. Treat every repo under them as my own internal source control."
    ]
  },
  "theme": "auto"
}
