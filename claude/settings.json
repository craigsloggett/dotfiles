{
  "agentPushNotifEnabled": false,
  "allowedMcpServers": [],
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "off",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_CONFIG_DIR}\"/hooks/save.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write"
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "\"${CLAUDE_CONFIG_DIR}\"/statusline-command.sh",
    "refreshInterval": 60,
    "type": "command"
  },
  "theme": "auto",
  "tui": "fullscreen",
  "useAutoModeDuringPlan": false,
  "voice": {
    "enabled": true
  }
}
